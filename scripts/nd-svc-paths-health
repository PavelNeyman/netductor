#!/bin/bash
set +e
OUT=/var/lib/netductor/svc-paths-health.json
DESIRED=/var/lib/netductor/failover-desired.json
SECRETS=/etc/netductor/secrets
POLICY=/etc/netductor/svc-paths/failover-policy.json
SB_CFG=/usr/local/etc/sing-box/config.json
mkdir -p /var/lib/netductor /etc/netductor/svc-paths

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
role=unknown
ip -br a 2>/dev/null | grep -q 10.87.10.1 && role=primary
ip -br a 2>/dev/null | grep -q 10.87.10.2 && role=secondary

ping_ok() { ping -c 1 -W 2 "$1" >/dev/null 2>&1; }

sp=0; ps=0; wss_sp=0; wss_ps=0
if [ "$role" = primary ]; then
  ping_ok 10.87.10.2 && sp=1
  ping_ok 10.87.11.2 && ps=1
  systemctl is-active --quiet nd-wss-sp-server && wss_sp=1
  systemctl is-active --quiet nd-wss-ps-client && wss_ps=1
else
  ping_ok 10.87.10.1 && sp=1
  ping_ok 10.87.11.1 && ps=1
  systemctl is-active --quiet nd-wss-sp-client && wss_sp=1
  systemctl is-active --quiet nd-wss-ps-server && wss_ps=1
fi

vless=0
PRIMARY_PUB=2.27.118.70
if [ -f "$SECRETS/secondary_core_url.public" ]; then
  PRIMARY_PUB=$(grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$SECRETS/secondary_core_url.public" | head -1)
  [ -z "$PRIMARY_PUB" ] && PRIMARY_PUB=2.27.118.70
fi
if [ "$role" = secondary ]; then
  timeout 3 bash -c "echo >/dev/tcp/${PRIMARY_PUB}/443" 2>/dev/null && vless=1
fi

printf '{"ts":"%s","role":"%s","svc_sp_up":%s,"svc_ps_up":%s,"wss_sp_unit":%s,"wss_ps_unit":%s,"vless_tcp443":%s}\n' \
  "$ts" "$role" "$sp" "$ps" "$wss_sp" "$wss_ps" "$vless" | tee "$OUT" >/dev/null

users_sp=0
[ -f "$POLICY" ] && grep -q '"users_to_sp_on_vless_down"[[:space:]]*:[[:space:]]*true' "$POLICY" && users_sp=1
# default on if no policy file yet
[ ! -f "$POLICY" ] && users_sp=1

user_path=vless
agent_mode=tunnel

if [ "$role" = secondary ]; then
  TUN=https://10.87.10.1:8789
  PUB=$(cat "$SECRETS/secondary_core_url.public" 2>/dev/null | tr -d '\n')
  [ -z "$PUB" ] && PUB="https://${PRIMARY_PUB}:8789"
  CUR=$(cat "$SECRETS/secondary_core_url" 2>/dev/null | tr -d '\n')
  if [ "$sp" = 1 ]; then WANT=$TUN; agent_mode=tunnel; else WANT=$PUB; agent_mode=public; fi
  if [ -n "$WANT" ] && [ "$CUR" != "$WANT" ]; then
    echo "$WANT" > "$SECRETS/secondary_core_url"
    chmod 600 "$SECRETS/secondary_core_url"
    systemctl try-reload-or-restart netductor-secondary-agent 2>/dev/null || systemctl try-reload-or-restart netductor-agent 2>/dev/null || true
    logger -t nd-svc-paths "agent_url -> $agent_mode $WANT"
  fi

  if [ -f "$SB_CFG" ] && command -v python3 >/dev/null; then
    if [ "$vless" = 1 ]; then
      target="$PRIMARY_PUB"; user_path=vless
    elif [ "$users_sp" = 1 ] && [ "$sp" = 1 ]; then
      target="10.87.10.1"; user_path=sp
    else
      target=""; user_path=degraded
    fi
    if [ -n "$target" ]; then
      changed=$(TARGET="$target" CFG="$SB_CFG" python3 -c '
import json,os
cfg=os.environ["CFG"]; target=os.environ["TARGET"]
c=json.load(open(cfg)); changed=False
for o in c.get("outbounds",[]):
  if o.get("tag")=="uplink" and o.get("type")=="vless":
    if o.get("server")!=target:
      o["server"]=target; changed=True
    break
if changed:
  open(cfg,"w").write(json.dumps(c,indent=2)+"\n"); print("1")
else:
  print("0")
')
      if [ "$changed" = 1 ]; then
        systemctl restart sing-box 2>/dev/null || true
        logger -t nd-svc-paths "user uplink -> $target ($user_path)"
      fi
    fi
  fi
  printf '{"ts":"%s","agent_url_mode":"%s","user_path":"%s","sp":%s,"ps":%s,"vless":%s,"users_sp_policy":%s}\n' \
    "$ts" "$agent_mode" "$user_path" "$sp" "$ps" "$vless" "$users_sp" > "$DESIRED"
fi

if [ "$role" = primary ] && command -v netductor >/dev/null; then
  netductor svc-paths failover tick >/dev/null 2>&1 || true
fi
if [ "$sp" = 1 ] && [ "$ps" = 1 ]; then exit 0; else exit 1; fi
