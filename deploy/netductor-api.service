[Unit]
Description=Netductor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NETDUCTOR_ADMIN_ROOT=/usr/local/share/netductor/admin
ExecStart=/usr/local/bin/netductor serve --bind 127.0.0.1 --port 8787 --no-proxy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
